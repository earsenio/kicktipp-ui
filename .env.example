# Kicktipp.com credentials (each user logs in with their own)
KICKTIPP_EMAIL=your@email.com
KICKTIPP_PASSWORD=yourpassword

# Kicktipp domain — use the locale matching your community
# Options: https://www.kicktipp.com | https://www.kicktipp.de | https://www.kicktipp.fr
KICKTIPP_URL=https://www.kicktipp.com

# API server port (default: 3001)
PORT=3001

# Frontend API URL (for browser requests in development)
# In production, leave unset — API and frontend are served from the same origin
NEXT_PUBLIC_API_URL=http://localhost:3001

# Secret key for encrypting session JWTs (64 hex chars = 32 bytes)
# Generate with: openssl rand -hex 32
SESSION_SECRET=
