{
  "name": "Tippkick",
  "short_name": "Tippkick",
  "description": "Open-source web UI for kicktipp.com — sports prediction game",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0a0a12",
  "theme_color": "#0a0a12",
  "icons": [
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
